# GameCraft AI - AI layer configuration
# Copy to .env and fill in the key(s) for the provider you use.
# Leave IMAGE_PROVIDER=mock to run fully offline (placeholder images, no keys needed).

# Image provider: mock | openai | gemini | replicate
IMAGE_PROVIDER=mock

# OpenAI (images + optional LLM plan expansion)
OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=gpt-image-1
# OPENAI_LLM_MODEL=gpt-4o-mini

# Gemini (images + optional LLM plan expansion)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-2.5-flash-image
# GEMINI_LLM_MODEL=gemini-2.5-flash

# Replicate (FLUX / SDXL)
# REPLICATE_API_TOKEN=
# REPLICATE_T2I_MODEL=black-forest-labs/flux-schnell
# REPLICATE_REF_MODEL=black-forest-labs/flux-kontext-pro

# LLM used for concept -> asset plan: openai | gemini | none | auto (default: auto)
# PLAN_LLM=auto

# Demo cache
# GAMECRAFT_CACHE_DIR=demo_cache
# DEMO_MODE=1
# LIVE_TIMEOUT_S=90
